generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  image             String?
  passwordHash      String?
  otpVerified       Boolean   @default(false)
  gender            String    @default("male")
  lookingFor        String    @default("bride")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("users")
}

model Otp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("otps")
}

model Profile {
  id                     String    @id @default(uuid())
  userId                 String    @unique @map("user_id")
  displayName            String    @map("display_name")
  mobileNumber           String    @map("mobile_number")
  email                  String?
  avatarUrl              String?   @map("avatar_url")
  coverImage             String?   @map("cover_image")
  gender                 String?
  age                    Int?
  height                 String?
  maritalStatus          String?   @map("marital_status")
  religion               String?
  motherTongue           String?   @map("mother_tongue")
  education              String?
  profession             String?
  city                   String?
  country                String    @default("India")
  bio                    String?
  provider               String    @default("otp")
  providerId             String?   @map("provider_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  membershipTier         String    @default("free") @map("membership_tier")
  membershipExpiresAt    DateTime? @map("membership_expires_at")
  dob                    DateTime? @db.Date
  birthTime              String?   @map("birth_time")
  birthPlace             String?   @map("birth_place")
  rashi                  String?
  nakshatra              String?
  manglik                String?
  gotra                  String?
  fatherOccupation       String?   @map("father_occupation")
  motherOccupation       String?   @map("mother_occupation")
  siblings               String?
  familyType             String?   @map("family_type")
  familyValues           String?   @map("family_values")
  diet                   String?
  smoking                String?
  drinking               String?
  disability             String?
  mobileVerified         Boolean   @default(false) @map("mobile_verified")
  emailVerified          Boolean   @default(false) @map("email_verified")
  idVerified             Boolean   @default(false) @map("id_verified")
  photoVerified          Boolean   @default(false) @map("photo_verified")
  verificationBadge      String?   @map("verification_badge")
  profileBoostExpiresAt  DateTime? @map("profile_boost_expires_at")
  profileBoostType       String?   @map("profile_boost_type")
  featuredProfile        Boolean   @default(false) @map("featured_profile")
  featuredProfileUntil   DateTime? @map("featured_profile_until")
  contactCredits         Int       @default(0) @map("contact_credits")
  hidePhone              Boolean   @default(false) @map("hide_phone")
  hideEmail              Boolean   @default(false) @map("hide_email")
  hideSurname            Boolean   @default(false) @map("hide_surname")
  hidePhotos             Boolean   @default(false) @map("hide_photos")
  photoPrivacy           String    @default("public") @map("photo_privacy")
  isSuspended            Boolean   @default(false) @map("is_suspended")
  lastActiveAt           DateTime? @map("last_active_at")

  @@map("profiles")
}

model PartnerPreference {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  partnerGender  String?   @map("partner_gender")
  ageMin         Int?      @map("age_min")
  ageMax         Int?      @map("age_max")
  heightMin      String?   @map("height_min")
  heightMax      String?   @map("height_max")
  religion       String?
  motherTongue   String?   @map("mother_tongue")
  maritalStatus  String?   @map("marital_status")
  city           String?
  education      String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("partner_preferences")
}

model Interest {
  id            String    @id @default(uuid())
  senderId      String    @map("sender_id")
  recipientId   String    @map("recipient_id")
  status        String    @default("pending")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([senderId, recipientId])
  @@map("interests")
}

model Shortlist {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  profileId  String    @map("profile_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([userId, profileId])
  @@map("shortlists")
}

model Conversation {
  id              String    @id @default(uuid())
  userA           String    @map("user_a")
  userB           String    @map("user_b")
  lastMessage     String?   @map("last_message")
  lastMessageAt   DateTime? @map("last_message_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  messages        ChatMessage[]

  @@unique([userA, userB])
  @@map("conversations")
}

model ChatMessage {
  id              String       @id @default(uuid())
  conversationId  String       @map("conversation_id")
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String       @map("sender_id")
  recipientId     String       @map("recipient_id")
  content         String
  createdAt       DateTime     @default(now()) @map("created_at")
  readAt          DateTime?    @map("read_at")

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model Report {
  id          String    @id @default(uuid())
  reporterId  String    @map("reporter_id")
  reportedId  String    @map("reported_id")
  reason      String
  details     String?
  status      String    @default("open")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([reportedId, status])
  @@map("reports")
}

model Block {
  id         String    @id @default(uuid())
  blockerId  String    @map("blocker_id")
  blockedId  String    @map("blocked_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@map("blocks")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  actorId   String?   @map("actor_id")
  type      String    @default("system")
  title     String?
  message   String
  data      Json?
  read      Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notifications")
}

model Verification {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  idType       String    @map("id_type")
  idNumber     String    @map("id_number")
  selfieUrl    String?   @map("selfie_url")
  documentUrl  String?   @map("document_url")
  status       String    @default("pending")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("verifications")
}

model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique
  discountType    String    @map("discount_type")
  discountValue   Int       @map("discount_value")
  applicablePlans String[]  @default([]) @map("applicable_plans")
  maxUses         Int       @default(1) @map("max_uses")
  usedCount       Int       @default(0) @map("used_count")
  perUserLimit    Int       @default(1) @map("per_user_limit")
  startsAt        DateTime  @map("starts_at")
  expiresAt       DateTime  @map("expires_at")
  isActive        Boolean   @default(true) @map("is_active")
  description     String?
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("coupons")
}

model ProfileBoost {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  boostType    String    @map("boost_type")
  expiresAt    DateTime  @map("expires_at")
  purchasedAt  DateTime  @default(now()) @map("purchased_at")
  isActive     Boolean   @default(true) @map("is_active")

  @@index([userId, isActive])
  @@index([expiresAt])
  @@map("profile_boosts")
}

model ContactCredit {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  credits     Int       @default(0)
  expiresAt   DateTime? @map("expires_at")
  purchasedAt DateTime  @default(now()) @map("purchased_at")
  source      String?

  @@map("contact_credits")
}

model FeaturedProfile {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  featuredUntil  DateTime  @map("featured_until")
  setByAdmin     Boolean   @default(false) @map("set_by_admin")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([featuredUntil])
  @@map("featured_profiles")
}

model OtpCode {
  id             String    @id @map("mobile_number")
  code           String
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  verifiedAt     DateTime? @map("verified_at")
  sendCount      Int       @default(0) @map("send_count")
  lastSentAt     DateTime? @map("last_sent_at")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")

  @@map("otp_codes")
}