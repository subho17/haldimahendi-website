# ==============================================================
# HaldiMeHendi - Environment Variables
# Copy this file to .env and fill in the values
# ==============================================================

# -----------------------------------------------
# Database (Supabase PostgreSQL)
# -----------------------------------------------
# Get from: Supabase Dashboard > Settings > Database > Connection string
# Use Port 6543 (Transaction Pooler) for Next.js
DATABASE_URL=""

# -----------------------------------------------
# Supabase Storage (Profile Photos)
# -----------------------------------------------
# Get from: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_BUCKET="profile photos"

# -----------------------------------------------
# SMS Provider (OTP Verification)
# -----------------------------------------------
SMS_PROVIDER="smsmedia"
OTP_API_KEY=""
SMS_CAMPAIGN=""
SMS_ROUTE_ID=""
SMS_SENDER_ID=""
SMS_TEMPLATE_ID=""
SMS_PE_ID=""
SMS_MESSAGE_TEMPLATE="Dear Member, Your client login account OTP is {#var#} It will expire in Five minutes. Do not share it with anyone. Thanks, -Webczar"

# -----------------------------------------------
# Google OAuth (Login with Google)
# -----------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------
# SMTP Email Notifications
# -----------------------------------------------
# For Gmail: Use App Password (not regular password)
# Enable 2FA > Go to https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="HaldiMeHendi"

# -----------------------------------------------
# AI Features (OpenAI / NVIDIA / Gemini)
# Set ONE provider's key to enable AI bios
# -----------------------------------------------
OPENAI_API_KEY=""
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# -----------------------------------------------
# App URLs
# -----------------------------------------------
NEXT_PUBLIC_SITE_URL="https://haldimehendi.com"
