# Supabase Postgres connection string
# Get this from: Supabase Dashboard > Project Settings > Database > Connection string (Pooler)
# Use Port 6543 (Transaction mode) for high concurrency serverless / Next.js environments
# Example: postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=""

# SMS Provider ('smsmedia' or 'fast2sms')
SMS_PROVIDER="smsmedia"

# SMS Gateway API Key
OTP_API_KEY="36A586CB145C7D"

# SMS Media Gateway Settings (DLT Details for India)
SMS_CAMPAIGN="10604"
SMS_ROUTE_ID="100867"
SMS_SENDER_ID="GOODAY"
SMS_TEMPLATE_ID="1707172038325802378"
SMS_PE_ID="1401856260000019479"

# DLT registered message template (#var# is replaced with the actual OTP)
SMS_MESSAGE_TEMPLATE="Dear Member, Your client login account OTP is {#var#} It will expire in Five minutes. Do not share it with anyone. Thanks, -Webczar"

# App URL (used for links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# NVIDIA NIM (build.nvidia.com) - OpenAI-compatible API
# Get your key from: https://build.nvidia.com (Personal API Key)
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
